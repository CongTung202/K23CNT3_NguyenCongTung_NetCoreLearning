@model nctLesson9.Models.Book

@{
    ViewData["Title"] = "Book Details";
}

<h2 class="mb-4">Book Details</h2>

<div class="card shadow-sm mb-4">
    <div class="row g-0">
        <div class="col-md-4 d-flex align-items-center justify-content-center p-3">
            @if (!string.IsNullOrEmpty(Model.Picture))
            {
                <img src="~/images/@Model.Picture" class="img-fluid rounded" alt="@Model.Title" style="max-height: 300px; object-fit: contain;" />
            }
            else
            {
                <div class="bg-light d-flex align-items-center justify-content-center rounded" style="height: 200px; width: 100%;">
                    <span class="text-muted">No Image</span>
                </div>
            }
        </div>
        <div class="col-md-8">
            <div class="card-body">
                <h4 class="card-title">@Model.Title</h4>
                <h6 class="card-subtitle mb-2 text-muted">by @Model.Author</h6>
                <dl class="row mb-0">
                    <dt class="col-sm-4">Release</dt>
                    <dd class="col-sm-8">@Model.Release?.ToString("d")</dd>
                    <dt class="col-sm-4">Price</dt>
                    <dd class="col-sm-8">@Model.Price?.ToString("C")</dd>
                    <dt class="col-sm-4">Category</dt>
                    <dd class="col-sm-8">@Model.Category?.CategoryName</dd>
                    <dt class="col-sm-4">Publisher</dt>
                    <dd class="col-sm-8">@Model.Publisher?.PublisherName</dd>
                    <dt class="col-sm-4">Description</dt>
                    <dd class="col-sm-8">@Model.Description</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

<div class="d-flex gap-2">
    <a asp-action="Edit" asp-route-id="@Model?.BookId" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>