@model nctLesson9.Models.Category

@{
    ViewData["Title"] = "Delete";
}

<h1 class="mb-4">Delete Category</h1>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <h3 class="text-danger mb-3">Are you sure you want to delete this?</h3>
                <dl class="row mb-4">
                    <dt class="col-sm-4"> @Html.DisplayNameFor(model => model.CategoryName) </dt>
                    <dd class="col-sm-8"> @Html.DisplayFor(model => model.CategoryName) </dd>
                </dl>
                <form asp-action="Delete">
                    <input type="hidden" asp-for="CategoryId" />
                    <button type="submit" class="btn btn-danger">Delete</button>
                    <a asp-action="Index" class="btn btn-secondary ms-2">Back to List</a>
                </form>
            </div>
        </div>
    </div>
</div>