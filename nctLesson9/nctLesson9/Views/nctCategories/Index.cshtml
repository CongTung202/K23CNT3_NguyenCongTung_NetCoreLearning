@model IEnumerable<nctLesson9.Models.Category>

@{
    ViewData["Title"] = "Categories";
}

<h1 class="mb-4">Categories</h1>

<div class="mb-3">
    <a asp-action="Create" class="btn btn-success">Create New</a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-striped mb-0">
            <thead class="table-light">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.First().CategoryName)</th>
                    <th style="width: 180px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.CategoryName)</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.CategoryId" class="btn btn-sm btn-primary">Sửa</a>
                            <a asp-action="Details" asp-route-id="@item.CategoryId" class="btn btn-sm btn-info text-white ms-1">Xem</a>
                            <a asp-action="Delete" asp-route-id="@item.CategoryId" class="btn btn-sm btn-danger ms-1">Xóa</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>