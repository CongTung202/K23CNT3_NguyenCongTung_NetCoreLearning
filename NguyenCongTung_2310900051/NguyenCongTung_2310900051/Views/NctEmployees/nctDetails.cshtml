@model NguyenCongTung_2310900051.Models.NctEmployee

@{
    ViewData["Title"] = "Employee Details";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-info text-white">
                    <h3 class="mb-0">Employee Details</h3>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Name</dt>
                        <dd class="col-sm-8">@Model.NctEmpName</dd>
                        <dt class="col-sm-4">Level</dt>
                        <dd class="col-sm-8">@Model.NctEmpLevel</dd>
                        <dt class="col-sm-4">Start Date</dt>
                        <dd class="col-sm-8">@Model.NctEmpStartDate</dd>
                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8">
                            @(Model.NctEmpStatus == true ? "Active" : "Inactive")
                        </dd>
                    </dl>
                </div>
                <div class="card-footer text-end">
                    <a asp-action="nctEdit" asp-route-id="@Model?.NctEmpId" class="btn btn-warning me-2">Edit</a>
                    <a asp-action="nctIndex" class="btn btn-secondary">Back to List</a>
                </div>
            </div>
        </div>
    </div>
</div>