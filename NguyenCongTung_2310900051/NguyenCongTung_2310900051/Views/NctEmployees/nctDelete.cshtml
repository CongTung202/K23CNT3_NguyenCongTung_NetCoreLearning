@model NguyenCongTung_2310900051.Models.NctEmployee

@{
    ViewData["Title"] = "Delete Employee";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-danger text-white">
                    <h3 class="mb-0">Delete Employee</h3>
                </div>
                <div class="card-body">
                    <h5 class="mb-3 text-danger">Are you sure you want to delete this employee?</h5>
                    <dl class="row">
                        <dt class="col-sm-4">Name</dt>
                        <dd class="col-sm-8">@Model.NctEmpName</dd>
                        <dt class="col-sm-4">Level</dt>
                        <dd class="col-sm-8">@Model.NctEmpLevel</dd>
                        <dt class="col-sm-4">Start Date</dt>
                        <dd class="col-sm-8">@Model.NctEmpStartDate</dd>
                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8">
                            @(Model.NctEmpStatus == true ? "Show" : "Hide")
                        </dd>
                    </dl>
                    <form asp-action="nctDelete">
                        <input type="hidden" asp-for="NctEmpId" />
                        <div class="d-flex justify-content-between">
                            <button type="submit" class="btn btn-danger">Delete</button>
                            <a asp-action="nctIndex" class="btn btn-secondary">Back to List</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>