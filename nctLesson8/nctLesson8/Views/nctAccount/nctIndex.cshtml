@model IEnumerable<nctLesson8.Models.nctAccounts>

@{
    ViewData["Title"] = "Index";
}

<h1 class="text-center my-4">Danh sách tài khoản</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Tạo tài khoản mới</a>
</p>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>@Html.DisplayNameFor(model => model.nctId)</th>
                <th>@Html.DisplayNameFor(model => model.nctFullName)</th>
                <th>@Html.DisplayNameFor(model => model.nctEmail)</th>
                <th>@Html.DisplayNameFor(model => model.nctPhone)</th>
                <th>@Html.DisplayNameFor(model => model.nctAddress)</th>
                <th>@Html.DisplayNameFor(model => model.nctAvatar)</th>
                <th>@Html.DisplayNameFor(model => model.nctBirthday)</th>
                <th>@Html.DisplayNameFor(model => model.nctFacebook)</th>
                <th class="text-center">Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.nctId)</td>
                    <td>@Html.DisplayFor(modelItem => item.nctFullName)</td>
                    <td>@Html.DisplayFor(modelItem => item.nctEmail)</td>
                    <td>@Html.DisplayFor(modelItem => item.nctPhone)</td>
                    <td>@Html.DisplayFor(modelItem => item.nctAddress)</td>
                    <td>
                        <img src="@item.nctAvatar" alt="Avatar" class="img-thumbnail" style="width: 50px; height: 50px;">
                    </td>
                    <td>@Html.DisplayFor(modelItem => item.nctBirthday)</td>
                    <td>@Html.DisplayFor(modelItem => item.nctFacebook)</td>
                    <td class="text-center">
                        <a class="btn btn-warning btn-sm" asp-action="nctEdit" asp-route-id="@item.nctId">Sửa</a>
                        <a class="btn btn-info btn-sm" asp-action="nctDetails" asp-route-id="@item.nctId">Chi tiết</a>
                        <a class="btn btn-danger btn-sm" asp-action="nctDelete" asp-route-id="@item.nctId">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
