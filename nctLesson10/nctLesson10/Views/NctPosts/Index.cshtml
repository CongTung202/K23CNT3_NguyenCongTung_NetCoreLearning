@model IEnumerable<nctLesson10.Models.NctPost>

@{
    ViewData["Title"] = "Posts";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Posts</h1>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> Create New
    </a>
</div>

<table class="table table-striped table-bordered align-middle">
    <thead class="table-dark">
        <tr>
            <th>@Html.DisplayNameFor(model => model.NctTitle)</th>
            <th>@Html.DisplayNameFor(model => model.NctImage)</th>
            <th>@Html.DisplayNameFor(model => model.NctContent)</th>
            <th>@Html.DisplayNameFor(model => model.NctStatus)</th>
            <th class="text-center">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.NctTitle)</td>
                <td>
                    @if (!string.IsNullOrEmpty(item.NctImage))
                    {
                        <img src="@item.NctImage" alt="Image" class="img-thumbnail" style="max-width: 80px; max-height: 80px;" />
                    }
                </td>
                <td>@Html.DisplayFor(modelItem => item.NctContent)</td>
                <td>
                    @if (item.NctStatus == true)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </td>
                <td class="text-center">
                    <a asp-action="Edit" asp-route-id="@item.NctId" class="btn btn-sm btn-primary me-1">Edit</a>
                    <a asp-action="Details" asp-route-id="@item.NctId" class="btn btn-sm btn-info me-1">Details</a>
                    <a asp-action="Delete" asp-route-id="@item.NctId" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>