@{
    ViewData["Title"] = "nctListFriendsBox";
    var friends = ViewBag.Friends as List<nctLesson4.Models.nctListFriends>;
}

<style>
    .friend-list-container {
        display: flex;
        flex-wrap: wrap;
        gap: 32px;
        justify-content: center;
        margin-top: 32px;
    }
    .profile-card {
        max-width: 340px;
        min-width: 300px;
        border: 1px solid #ccc;
        background: #fff;
        text-align: center;
        font-family: Arial, sans-serif;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        margin-bottom: 24px;
        display: flex;
        flex-direction: column;
    }
    .profile-card .profile-img {
        width: 100%;
        height: 220px;
        object-fit: cover;
        object-position: top;
        border-bottom: 1px solid #eee;
        background: #222;
    }
    .profile-card .profile-name {
        font-size: 2rem;
        font-weight: 500;
        margin: 24px 0 8px 0;
    }
    .profile-card .profile-role {
        color: #888;
        font-size: 1.1rem;
        margin-bottom: 8px;
    }
    .profile-card .profile-school {
        font-size: 1rem;
        margin-bottom: 16px;
    }
    .profile-card .profile-social {
        margin-bottom: 20px;
    }
    .profile-card .profile-social a {
        color: #222;
        margin: 0 8px;
        font-size: 1.3rem;
        text-decoration: none;
        transition: color 0.2s;
    }
    .profile-card .profile-social a:hover {
        color: #007bff;
    }
    .profile-card .contact-btn {
        display: block;
        width: 100%;
        background: #111;
        color: #fff;
        border: none;
        padding: 14px 0;
        font-size: 1.1rem;
        font-weight: 500;
        cursor: pointer;
        text-decoration: none;
        border-radius: 0;
        margin-top: auto;
    }
</style>

<h1>nctListFriendsBox</h1>

<div class="friend-list-container">
    @if (friends != null && friends.Count > 0)
    {
        foreach (var friend in friends)
        {
            <div class="profile-card">
                <img src="@friend.Image" alt="@friend.Name" class="profile-img" />
                <div class="profile-name">@friend.Name</div>
                <div class="profile-school text-info fw-bold">@friend.Age</div>
                <div class="profile-school ">@friend.Address</div>
                <a asp-action="nctDetailsFriends" asp-route-id="@friend.ID" class="contact-btn">Chi Tiết</a>

            </div>
        }
    }
    else
    {
        <p>Không có bạn bè nào.</p>
    }
</div>
