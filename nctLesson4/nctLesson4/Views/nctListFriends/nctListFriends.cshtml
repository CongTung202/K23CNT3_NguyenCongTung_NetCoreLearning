@{
    ViewData["Title"] = "nctListFriends";
    var friends = ViewBag.Friends as List<nctLesson4.Models.nctListFriends>;
}

<h1>Danh Sách Bạn Bè</h1>
<a asp-action="nctCreateFriends" asp-controller="nctListFriends" class="btn btn-primary mx-3 mt-3 mb-1">Thêm Mới</a>
@if (friends != null && friends.Count > 0)
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Name</th>
                <th>Age</th>
                <th>Address</th>
                <th>Image</th>
                <th>Email</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var friend in friends)
        {
            <tr>
                <td>@friend.Name</td>
                <td>@friend.Age</td>
                <td>@friend.Address</td>
                <td>
                    @if (!string.IsNullOrEmpty(friend.Image))
                    {
                        <img src="@friend.Image" alt="@friend.Name" style="max-width:100px;" />
                    }
                </td>
                <td>@friend.Email</td>
                    <td>
                    <a asp-action="nctDetailsFriends" asp-route-id="@friend.ID" class="btn btn-info btn-sm">Xem</a>
                    <a asp-action="nctEditFriends" asp-route-id="@friend.ID" class="btn btn-success btn-sm">Sửa</a>
                    <a asp-action="nctDeleteFriends" asp-route-id="@friend.ID" class="btn btn-danger btn-sm">Xóa</a>
                        
                </td>

            </tr>
        }
        </tbody>
    </table>
}
else
{
    <p>No friends found.</p>
}

