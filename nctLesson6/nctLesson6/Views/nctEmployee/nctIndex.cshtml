@model IEnumerable<nctLesson6.Models.nctEmployee>
@{
    ViewData["Title"] = "Employee List";
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />

<div class="container mt-4">
    <h2>Employee List</h2>
    <a class="btn btn-primary mb-3" href="@Url.Action("nctCreate", "nctEmployee")">Add New Employee</a>
    <table class="table table-bordered">
        <thead class="table-thead bg bg-primary">
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>BirthDay</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Salary</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var emp in Model)
            {
                <tr>
                    <td>@emp.nctId</td>
                    <td>@emp.nctName</td>
                    <td>@emp.nctBirthDay.ToString("yyyy-MM-dd")</td>
                    <td>@emp.nctEmail</td>
                    <td>@emp.nctPhone</td>
                    <td>@emp.nctSalary</td>
                    <td>
                        @if (emp.nctStatus)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </td>
                    <td>
                        <a class="btn btn-warning btn-sm" href="@Url.Action("nctEdit", "nctEmployee", new { id = emp.nctId })">Edit</a>
                        <a class="btn btn-danger btn-sm" href="@Url.Action("nctDelete", "nctEmployee", new { id = emp.nctId })" onclick="return confirm('Are you sure you want to delete this employee?');">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>