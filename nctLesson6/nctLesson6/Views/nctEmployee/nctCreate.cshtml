@model nctLesson6.Models.nctEmployee
@{
    ViewData["Title"] = "Create Employee";
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />

<div class="container mt-4">
    <h2>Create New Employee</h2>
    <form asp-action="nctCreateSubmit" method="post" class="mt-3">
        <div class="mb-3">
            <label asp-for="nctName" class="form-label"></label>
            <input asp-for="nctName" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="nctBirthDay" class="form-label"></label>
            <input asp-for="nctBirthDay" type="date" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="nctEmail" class="form-label"></label>
            <input asp-for="nctEmail" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="nctPhone" class="form-label"></label>
            <input asp-for="nctPhone" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="nctSalary" class="form-label"></label>
            <input asp-for="nctSalary" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="nctStatus" class="form-label"></label>
            <select asp-for="nctStatus" class="form-select">
                <option value="true">Active</option>
                <option value="false">Inactive</option>
            </select>
        </div>
        <button type="submit" class="btn btn-success">Create</button>
        <a class="btn btn-secondary" href="@Url.Action("nctIndex", "nctEmployee")">Back to List</a>
    </form>
</div>